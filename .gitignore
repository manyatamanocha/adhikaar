# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev server log
.devlog

# impeccable: keep config.json (the design-rule decisions), drop session state
.impeccable/questions/
.impeccable/hook.cache.json

# design canvas working files (the seeded output is 200KB of editor payload)
design/adhikaar-landing-page.html
design/extracted/
.superpowers
